---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hello, Reader!</h1>
			<p>
				Welcome to our personal cookbook! This site contains a collection of some of our 
				favorite recipes, along with credit to where we sourced the recipe from (if available).
			</p>
			<p>
				Use the top nav bar to checkout the recipes!
			</p>
			<p>
				Any modifications we made to a recipe are built-in to the recipe and are not called 
				out separately.
			</p>
			<p>
				We grew tired of dealing with cooking blog website that are crammed with ads and 
				such, making it hard to navigate and prone to bad performance on tablet/mobile devices. 
				We've tried a few other solutions with mixed results, so we're hoping that this site 
				works out for us.
			</p>
		</main>
		<Footer />
	</body>
</html>
